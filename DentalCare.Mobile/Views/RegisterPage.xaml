<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DentalCare.Mobile.Views.RegisterPage"
    BackgroundColor="#F5F8FA"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,35,28,30" Spacing="17">

            <Label Text="DentalCare"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#123B4A"
                   HorizontalOptions="Center"/>

            <Label Text="Kreirajte svoj račun"
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="#183E4C"/>

            <Label Text="Popunite podatke kako biste nastavili."
                   FontSize="14"
                   TextColor="#82949D"/>

            <VerticalStackLayout Spacing="6">
                <Label Text="Ime i prezime"
                       TextColor="#183E4C"
                       FontAttributes="Bold"/>
                <Entry x:Name="FullNameEntry"
                       Placeholder="Unesite ime i prezime"
                       BackgroundColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Email adresa"
                       TextColor="#183E4C"
                       FontAttributes="Bold"/>
                <Entry x:Name="EmailEntry"
                       Placeholder="ime@email.com"
                       Keyboard="Email"
                       BackgroundColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Broj telefona"
                       TextColor="#183E4C"
                       FontAttributes="Bold"/>
                <Entry x:Name="PhoneEntry"
                       Placeholder="06X XXX XXX"
                       Keyboard="Telephone"
                       BackgroundColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Lozinka"
                       TextColor="#183E4C"
                       FontAttributes="Bold"/>
                <Entry x:Name="PasswordEntry"
                       Placeholder="Kreirajte lozinku"
                       IsPassword="True"
                       BackgroundColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Potvrdite lozinku"
                       TextColor="#183E4C"
                       FontAttributes="Bold"/>
                <Entry x:Name="ConfirmPasswordEntry"
                       Placeholder="Ponovite lozinku"
                       IsPassword="True"
                       BackgroundColor="White"/>
            </VerticalStackLayout>

            <Button Text="Registruj se"
                    Clicked="OnRegisterClicked"
                    BackgroundColor="#087F8C"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="14"
                    HeightRequest="54"/>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="5">

                <Label Text="Već imate račun?"
                       TextColor="#82949D"/>

                <Label Text="Prijavite se"
                       TextColor="#087F8C"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnLoginTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
