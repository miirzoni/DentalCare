<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DentalCare.Mobile.MainPage"
    BackgroundColor="#F5F8FA"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,25,22,20" Spacing="22">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="DentalCare"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#123B4A"/>
                        <Label Text="Vaš osmijeh, naša briga."
                               FontSize="13"
                               TextColor="#82949D"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="White"
                            Stroke="#E6EDF0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">
                        <Label Text="👤"
                               FontSize="23"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Welcome -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Dobro došli! 👋"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="#183E4C"/>
                    <Label Text="Drago nam je što brinete o svom osmijehu."
                           FontSize="13"
                           TextColor="#82949D"/>
                </VerticalStackLayout>

                <!-- Appointment CTA -->
                <Border BackgroundColor="#087F8C"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="20">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <VerticalStackLayout Spacing="10"
                                             VerticalOptions="Center">
                            <Label Text="ZAKAŽITE PREGLED"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#C8F4F1"/>
                            <Label Text="Vrijeme je za zdrav osmijeh!"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineHeight="1.15"/>
                            <Button Text="Zakaži termin  →"
                                    Clicked="OnBookAppointmentClicked"
                                    BackgroundColor="White"
                                    TextColor="#087F8C"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HorizontalOptions="Start"
                                    Padding="17,10"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="1"
                               Text="🦷"
                               FontSize="48"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Upcoming appointment -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Naredni termin"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#183E4C"/>
                        <Label Grid.Column="1"
                               Text="Pogledaj sve  →"
                               FontSize="12"
                               TextColor="#087F8C"
                               VerticalOptions="Center"/>
                    </Grid>

                    <Border BackgroundColor="White"
                            Stroke="#E8EEF1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="16">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Border BackgroundColor="#E7F6F5"
                                    WidthRequest="60"
                                    HeightRequest="65"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="1"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="Center">
                                    <Label Text="DEC"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#087F8C"/>
                                    <Label Text="05"
                                           FontSize="25"
                                           FontAttributes="Bold"
                                           TextColor="#183E4C"/>
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="5"
                                                 VerticalOptions="Center">
                                <Label Text="Kontrolni pregled"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#183E4C"/>
                                <Label Text="Dr. stomatolog · 10:30"
                                       FontSize="12"
                                       TextColor="#82949D"/>
                                <Label Text="●  Potvrđen termin"
                                       FontSize="11"
                                       TextColor="#15966D"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Quick actions -->
                <VerticalStackLayout Spacing="13">
                    <Label Text="Brzi pristup"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#183E4C"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <Border BackgroundColor="White"
                                Stroke="#E8EEF1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="15">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="📅" FontSize="27"/>
                                <Label Text="Moji termini"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#183E4C"/>
                                <Label Text="Pregled zakazivanja"
                                       FontSize="11"
                                       TextColor="#82949D"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="#E8EEF1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="15">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="📋" FontSize="27"/>
                                <Label Text="Historija"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#183E4C"/>
                                <Label Text="Prethodni pregledi"
                                       FontSize="11"
                                       TextColor="#82949D"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1"
                                BackgroundColor="White"
                                Stroke="#E8EEF1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="15">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="🦷" FontSize="27"/>
                                <Label Text="Usluge"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#183E4C"/>
                                <Label Text="Stomatološki tretmani"
                                       FontSize="11"
                                       TextColor="#82949D"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="#E8EEF1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="15">
                            <VerticalStackLayout Spacing="9">
                                <Label Text="👤" FontSize="27"/>
                                <Label Text="Moj profil"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#183E4C"/>
                                <Label Text="Lični podaci"
                                       FontSize="11"
                                       TextColor="#82949D"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <Label Text="DentalCare © 2026"
                       FontSize="11"
                       TextColor="#A0ADB3"
                       HorizontalOptions="Center"
                       Margin="0,5,0,5"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E8EEF1"
                StrokeThickness="1"
                Padding="8,10,8,12">
            <Grid ColumnDefinitions="*,*,*,*">
                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="⌂"
                           FontSize="23"
                           TextColor="#087F8C"
                           HorizontalOptions="Center"/>
                    <Label Text="Početna"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#087F8C"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="▦"
                           FontSize="22"
                           TextColor="#82949D"
                           HorizontalOptions="Center"/>
                    <Label Text="Termini"
                           FontSize="10"
                           TextColor="#82949D"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="♡"
                           FontSize="23"
                           TextColor="#82949D"
                           HorizontalOptions="Center"/>
                    <Label Text="Historija"
                           FontSize="10"
                           TextColor="#82949D"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="○"
                           FontSize="23"
                           TextColor="#82949D"
                           HorizontalOptions="Center"/>
                    <Label Text="Profil"
                           FontSize="10"
                           TextColor="#82949D"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>